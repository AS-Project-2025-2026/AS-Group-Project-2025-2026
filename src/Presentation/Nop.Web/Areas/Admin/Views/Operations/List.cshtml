@model Nop.Web.Areas.Admin.Models.Operations.OperationsSearchModel

@{
    ViewBag.PageTitle = "Integration Operations";
    NopHtml.SetActiveMenuItemSystemName("Integration Operations");
}

<style>
    .ops-section { margin-bottom: 1.5rem; }
    .ops-section .card-header {
        background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
        border-bottom: 2px solid #e9ecef;
        padding: .75rem 1.25rem;
    }
    .ops-section .card-header h5 {
        font-size: .95rem; font-weight: 700; color: #2d3748;
        display: flex; align-items: center; gap: .5rem; margin: 0;
    }
    .ops-section .card-header h5 .section-icon {
        width: 28px; height: 28px; border-radius: 6px;
        display: inline-flex; align-items: center; justify-content: center;
        font-size: .85rem; flex-shrink: 0;
    }
    .icon-outbox     { background: #dbeafe; color: #1d4ed8; }
    .icon-deadletter { background: #fee2e2; color: #b91c1c; }
    .icon-circuit    { background: #fef3c7; color: #b45309; }
    .icon-inventory  { background: #d1fae5; color: #065f46; }
    .icon-metrics    { background: #e0f2fe; color: #0369a1; }
    .driver-metrics {
        display: grid;
        grid-template-columns: repeat(4, minmax(180px, 1fr));
        gap: .75rem;
    }
    .driver-metric {
        border: 1.5px solid #e2e8f0;
        border-left-width: 5px;
        border-radius: 6px;
        padding: .8rem .9rem;
        background: #fff;
        min-height: 128px;
    }
    .driver-metric.healthy { border-left-color: #10b981; }
    .driver-metric.watch { border-left-color: #f59e0b; }
    .driver-metric.degraded { border-left-color: #ef4444; }
    .driver-title {
        display: flex;
        justify-content: space-between;
        gap: .5rem;
        font-size: .78rem;
        font-weight: 800;
        color: #334155;
        text-transform: uppercase;
        letter-spacing: .04em;
    }
    .driver-value {
        margin-top: .5rem;
        font-size: 1.55rem;
        font-weight: 800;
        color: #111827;
        line-height: 1.1;
    }
    .driver-secondary {
        margin-top: .45rem;
        color: #64748b;
        font-size: .8rem;
        line-height: 1.35;
    }
    .driver-updated {
        color: #64748b;
        font-size: .78rem;
        font-weight: 600;
    }
    .section-count {
        font-size: .72rem; font-weight: 700; padding: .2em .55em;
        border-radius: 999px; background: #e2e8f0; color: #4a5568;
        margin-left: .25rem;
    }
    .ops-refresh-btn {
        display: inline-flex; align-items: center; gap: .35rem;
        font-size: .78rem; font-weight: 600; padding: .35rem .75rem;
        border-radius: 6px; border: 1.5px solid #cbd5e0;
        background: #fff; color: #4a5568; cursor: pointer;
        transition: all .15s ease; text-decoration: none;
    }
    .ops-refresh-btn:hover { background: #edf2f7; border-color: #a0aec0; color: #2d3748; }
    .ops-refresh-btn:active { transform: scale(.97); }
    .ops-refresh-btn .spin { display: inline-block; transition: transform .4s; }
    .ops-refresh-btn:active .spin { transform: rotate(180deg); }
    .badge-status { font-size: .75rem; padding: .28em .6em; border-radius: 999px; font-weight: 700; display:inline-block; letter-spacing: .01em; }
    .badge-published    { background:#d1fae5; color:#065f46; }
    .badge-pending      { background:#fef3c7; color:#92400e; }
    .badge-retrying     { background:#fef3c7; color:#92400e; }
    .badge-failed       { background:#fee2e2; color:#991b1b; }
    .badge-requeued     { background:#dbeafe; color:#1e40af; }
    .badge-new          { background:#fee2e2; color:#991b1b; }
    .badge-acknowledged { background:#fef3c7; color:#92400e; }
    .badge-open         { background:#fee2e2; color:#991b1b; font-weight:800; }
    .badge-halfopen     { background:#fef3c7; color:#92400e; font-weight:800; }
    .badge-closed       { background:#d1fae5; color:#065f46; }
    .badge-stale        { background:#fef3c7; color:#92400e; }
    .badge-conflict     { background:#fee2e2; color:#991b1b; font-weight:800; }
    .badge-ok           { background:#d1fae5; color:#065f46; }
    .badge-watch        { background:#fef3c7; color:#92400e; }
    .ops-table { font-size: .84rem; }
    .ops-table th { background: #f7fafc; font-weight: 700; font-size: .75rem; text-transform: uppercase; letter-spacing: .05em; color: #718096; border-top: none; border-bottom: 2px solid #e2e8f0; }
    .ops-table td { vertical-align: middle; border-color: #f0f4f8; }
    .ops-table tbody tr:hover { background: #f7fafc; }
    .ops-empty { text-align:center; color:#a0aec0; padding: 2rem 0; font-size: .88rem; }
    .requeue-btn {
        font-size: .75rem; padding: .3rem .7rem; font-weight: 700;
        border-radius: 6px; border: none; cursor: pointer;
        display: inline-flex; align-items: center; gap: .3rem;
        transition: all .15s ease;
    }
    .requeue-btn-warn   { background: #fef3c7; color: #92400e; border: 1.5px solid #f6d860; }
    .requeue-btn-warn:hover   { background: #fde68a; }
    .requeue-btn-danger { background: #fee2e2; color: #991b1b; border: 1.5px solid #fca5a5; }
    .requeue-btn-danger:hover { background: #fecaca; }
    .truncate-col { max-width:220px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .order-link { font-weight:700; color:#3b82f6; text-decoration:none; }
    .order-link:hover { color:#1d4ed8; text-decoration:underline; }
    .msg-type-badge { font-size:.73rem; padding:.22em .5em; border-radius:.25rem; background:#e9ecef; color:#495057; font-family:monospace; font-weight:600; }
    .msg-type-fulfillment { background:#dbeafe; color:#1e40af; }
    .msg-type-shipping    { background:#ede9fe; color:#5b21b6; }
    .msg-type-inventory   { background:#d1fae5; color:#065f46; }
    .adapter-badge { font-size:.73rem; padding:.22em .5em; border-radius:.25rem; font-family:monospace; font-weight:700; }
    .adapter-warehouse  { background:#dbeafe; color:#1e40af; }
    .adapter-shipping   { background:#ede9fe; color:#5b21b6; }
    .adapter-inventory  { background:#d1fae5; color:#065f46; }
    .adapter-storepos   { background:#ffedd5; color:#9a3412; }
    .adapter-support    { background:#fef9c3; color:#713f12; }
    .failure-bar { height:6px; border-radius:3px; background:#e2e8f0; min-width:60px; display:inline-block; vertical-align:middle; margin-left:6px; }
    .failure-bar-fill { height:100%; border-radius:3px; }
    .corr-id { font-family:monospace; font-size:.78rem; color:#718096; }
    .error-tooltip { cursor:help; border-bottom:1px dashed #a0aec0; }
    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter { padding-top: .4rem; }
    .dataTables_wrapper .dataTables_info { font-size: .8rem; color: #718096; padding-top: .6rem; }
    .ops-section div.dt-container div.dt-layout-row {
        align-items: center;
        margin: .65rem 0 0;
    }
    .ops-section div.dt-container div.dt-info,
    .ops-section div.dt-container div.dt-length {
        color: #718096;
        font-size: .8rem;
    }
    .ops-section div.dt-container div.dt-paging nav {
        display: inline-flex;
        align-items: center;
        gap: .25rem;
    }
    .ops-section div.dt-container button.dt-paging-button {
        appearance: none;
        -webkit-appearance: none;
        border-radius: 6px !important;
        font-size: .8rem !important;
        font-weight: 600;
        line-height: 1.35;
        padding: .3rem .65rem !important;
        border: 1.5px solid #e2e8f0 !important;
        background: #fff !important;
        color: #4a5568 !important;
        cursor: pointer;
        min-width: 2rem;
    }
    .ops-section div.dt-container button.dt-paging-button.current,
    .ops-section div.dt-container button.dt-paging-button.current:hover {
        background: #3b82f6 !important;
        border-color: #3b82f6 !important;
        color: #fff !important;
    }
    .ops-section div.dt-container button.dt-paging-button:hover:not(.current):not(.disabled) {
        background: #edf2f7 !important;
        border-color: #a0aec0 !important;
        color: #2d3748 !important;
    }
    .ops-section div.dt-container button.dt-paging-button.disabled {
        opacity: .45 !important;
        cursor: default !important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button {
        border-radius: 6px !important; font-size: .8rem !important;
        padding: .3rem .65rem !important; margin: 0 2px !important;
        border: 1.5px solid #e2e8f0 !important; background: #fff !important;
        color: #4a5568 !important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current {
        background: #3b82f6 !important; color: #fff !important;
        border-color: #3b82f6 !important; font-weight: 700 !important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button:hover:not(.current) {
        background: #edf2f7 !important; color: #2d3748 !important;
        border-color: #a0aec0 !important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button.disabled {
        opacity: .4 !important; cursor: default !important;
    }
    .dataTables_wrapper select.form-control,
    .dataTables_wrapper input.form-control {
        border-radius: 6px; border: 1.5px solid #e2e8f0; font-size: .82rem;
    }
    @@media (max-width: 1199px) {
        .driver-metrics { grid-template-columns: repeat(2, minmax(180px, 1fr)); }
    }
    @@media (max-width: 767px) {
        .driver-metrics { grid-template-columns: 1fr; }
    }
</style>

<div class="content-header clearfix">
    <h1 class="float-left">Integration Operations</h1>
</div>

<section class="content">
    <div class="container-fluid">

        @* ── Architectural Driver Metrics ── *@
        <div class="card card-default ops-section">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5>
                    <span class="section-icon icon-metrics">&#x1F4CA;</span>
                    Architectural Driver Metrics
                    <span class="section-count" id="metrics-overall">—</span>
                </h5>
                <div class="d-flex align-items-center" style="gap:.75rem">
                    <span class="driver-updated" id="metrics-updated">—</span>
                    <a class="ops-refresh-btn" href="http://localhost:3000/d/verdemart-architectural-drivers/verdemart-architectural-drivers" target="_blank" rel="noopener">
                        Grafana
                    </a>
                    <button class="ops-refresh-btn" onclick="refreshMetrics()">
                        <span class="spin">&#x21bb;</span> Refresh
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="driver-metrics">
                    <div class="driver-metric" id="metric-availability">
                        <div class="driver-title">
                            <span>Availability</span>
                            <span id="metric-availability-status">—</span>
                        </div>
                        <div class="driver-value" id="metric-availability-value">—</div>
                        <div class="driver-secondary" id="metric-availability-detail">—</div>
                    </div>
                    <div class="driver-metric" id="metric-resilience">
                        <div class="driver-title">
                            <span>Resilience</span>
                            <span id="metric-resilience-status">—</span>
                        </div>
                        <div class="driver-value" id="metric-resilience-value">—</div>
                        <div class="driver-secondary" id="metric-resilience-detail">—</div>
                    </div>
                    <div class="driver-metric" id="metric-consistency">
                        <div class="driver-title">
                            <span>Consistency</span>
                            <span id="metric-consistency-status">—</span>
                        </div>
                        <div class="driver-value" id="metric-consistency-value">—</div>
                        <div class="driver-secondary" id="metric-consistency-detail">—</div>
                    </div>
                    <div class="driver-metric" id="metric-operability">
                        <div class="driver-title">
                            <span>Operability</span>
                            <span id="metric-operability-status">—</span>
                        </div>
                        <div class="driver-value" id="metric-operability-value">—</div>
                        <div class="driver-secondary" id="metric-operability-detail">—</div>
                    </div>
                </div>
            </div>
        </div>

        @* ── Outbox ── *@
        <div class="card card-default ops-section">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5>
                    <span class="section-icon icon-outbox">&#x1F4EC;</span>
                    Outbox
                    <span class="section-count" id="outbox-count">—</span>
                </h5>
                <button class="ops-refresh-btn" onclick="$('#outbox-grid').DataTable().ajax.reload()">
                    <span class="spin">&#x21bb;</span> Refresh
                </button>
            </div>
            <div class="card-body">
                @await Html.PartialAsync("Table", new DataTablesModel
                {
                    Name = "outbox-grid",
                    UrlRead = new DataUrl("OutboxList", "Operations", null),
                    Length = Model.OutboxSearch.PageSize,
                    LengthMenu = Model.OutboxSearch.AvailablePageSizes,
                    ColumnCollection = new List<ColumnProperty>
                    {
                        new ColumnProperty(nameof(Nop.Web.Areas.Admin.Models.Operations.OutboxRecordModel.OrderId))
                        {
                            Title = "Order", Width = "100",
                            Render = new RenderCustom("renderOrderLinkWithCorr")
                        },
                        new ColumnProperty(nameof(Nop.Web.Areas.Admin.Models.Operations.OutboxRecordModel.MessageType))
                        {
                            Title = "Message Type",
                            Render = new RenderCustom("renderMsgType")
                        },
                        new ColumnProperty(nameof(Nop.Web.Areas.Admin.Models.Operations.OutboxRecordModel.Status))
                        {
                            Title = "Status",
                            Width = "100",
                            Render = new RenderCustom("renderOutboxStatus")
                        },
                        new ColumnProperty(nameof(Nop.Web.Areas.Admin.Models.Operations.OutboxRecordModel.RetryCount))
                        {
                            Title = "Retries", Width = "65"
                        },
                        new ColumnProperty(nameof(Nop.Web.Areas.Admin.Models.Operations.OutboxRecordModel.CreatedAtUtc))
                        {
                            Title = "Created (UTC)"
                        },
                        new ColumnProperty(nameof(Nop.Web.Areas.Admin.Models.Operations.OutboxRecordModel.NextAttemptAtUtc))
                        {
                            Title = "Next Attempt (UTC)"
                        },
                        new ColumnProperty(nameof(Nop.Web.Areas.Admin.Models.Operations.OutboxRecordModel.LastError))
                        {
                            Title = "Last Error",
                            Render = new RenderCustom("renderError")
                        },
                        new ColumnProperty(nameof(Nop.Web.Areas.Admin.Models.Operations.OutboxRecordModel.Id))
                        {
                            Title = "",
                            Width = "90",
                            ClassName = NopColumnClassDefaults.Button,
                            Render = new RenderCustom("renderRequeueOutbox")
                        }
                    }
                })
            </div>
        </div>

        @* ── Dead Letters ── *@
        <div class="card card-default ops-section">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5>
                    <span class="section-icon icon-deadletter">&#x26A0;&#xFE0F;</span>
                    Dead Letters
                    <span class="section-count" id="deadletter-count">—</span>
                </h5>
                <button class="ops-refresh-btn" onclick="$('#deadletter-grid').DataTable().ajax.reload()">
                    <span class="spin">&#x21bb;</span> Refresh
                </button>
            </div>
            <div class="card-body">
                @await Html.PartialAsync("Table", new DataTablesModel
                {
                    Name = "deadletter-grid",
                    UrlRead = new DataUrl("DeadLetterList", "Operations", null),
                    Length = Model.DeadLetterSearch.PageSize,
                    LengthMenu = Model.DeadLetterSearch.AvailablePageSizes,
                    ColumnCollection = new List<ColumnProperty>
                    {
                        new ColumnProperty(nameof(Nop.Web.Areas.Admin.Models.Operations.DeadLetterRecordModel.Id))
                        {
                            Title = "Id", Width = "50"
                        },
                        new ColumnProperty(nameof(Nop.Web.Areas.Admin.Models.Operations.DeadLetterRecordModel.CorrelationId))
                        {
                            Title = "Correlation ID",
                            Render = new RenderCustom("renderDlCorrelation")
                        },
                        new ColumnProperty(nameof(Nop.Web.Areas.Admin.Models.Operations.DeadLetterRecordModel.Adapter))
                        {
                            Title = "Adapter", Width = "110",
                            Render = new RenderCustom("renderAdapterBadge")
                        },
                        new ColumnProperty(nameof(Nop.Web.Areas.Admin.Models.Operations.DeadLetterRecordModel.EscalationState))
                        {
                            Title = "State", Width = "110",
                            Render = new RenderCustom("renderDlState")
                        },
                        new ColumnProperty(nameof(Nop.Web.Areas.Admin.Models.Operations.DeadLetterRecordModel.FailureReason))
                        {
                            Title = "Failure Reason",
                            Render = new RenderCustom("renderError")
                        },
                        new ColumnProperty(nameof(Nop.Web.Areas.Admin.Models.Operations.DeadLetterRecordModel.CreatedAtUtc))
                        {
                            Title = "Created (UTC)"
                        },
                        new ColumnProperty(nameof(Nop.Web.Areas.Admin.Models.Operations.DeadLetterRecordModel.LastAttemptAtUtc))
                        {
                            Title = "Last Attempt (UTC)"
                        },
                        new ColumnProperty(nameof(Nop.Web.Areas.Admin.Models.Operations.DeadLetterRecordModel.Id))
                        {
                            Title = "",
                            Width = "90",
                            ClassName = NopColumnClassDefaults.Button,
                            Render = new RenderCustom("renderRequeueDeadLetter")
                        }
                    }
                })
            </div>
        </div>

        @* ── Circuit Breaker State ── *@
        <div class="card card-default ops-section">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5>
                    <span class="section-icon icon-circuit">&#x26A1;</span>
                    Circuit Breaker State
                    <span class="section-count" id="cb-count">—</span>
                </h5>
                <button class="ops-refresh-btn" onclick="refreshCircuitBreakers()">
                    <span class="spin">&#x21bb;</span> Refresh
                </button>
            </div>
            <div class="card-body p-0">
                <table class="table ops-table mb-0" id="circuit-breaker-table">
                    <thead>
                        <tr>
                            <th>Adapter</th>
                            <th>State</th>
                            <th>Failures / Threshold</th>
                            <th>Opened (UTC)</th>
                            <th>Next Probe (UTC)</th>
                            <th>Last Error</th>
                            <th>Updated (UTC)</th>
                        </tr>
                    </thead>
                    <tbody id="circuit-breaker-body">
                        <tr><td colspan="7" class="ops-empty">Loading...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        @* ── Inventory Projection ── *@
        <div class="card card-default ops-section">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5>
                    <span class="section-icon icon-inventory">&#x1F4E6;</span>
                    Inventory Projection — Stale &amp; Conflicted
                    <span class="section-count" id="inv-count">—</span>
                </h5>
                <button class="ops-refresh-btn" onclick="refreshInventoryProjections()">
                    <span class="spin">&#x21bb;</span> Refresh
                </button>
            </div>
            <div class="card-body p-0">
                <table class="table ops-table mb-0" id="inventory-projection-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Source</th>
                            <th>Reported Qty</th>
                            <th>Last Confirmed (UTC)</th>
                            <th>Stale</th>
                            <th>Conflict</th>
                            <th>Pending Reconciliation</th>
                            <th>Resolved (UTC)</th>
                            <th>Updated (UTC)</th>
                        </tr>
                    </thead>
                    <tbody id="inventory-projection-body">
                        <tr><td colspan="9" class="ops-empty">Loading...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</section>

<script>
    var CB_THRESHOLD = 5; // must match Resilience__CircuitFailureThreshold

    function readField(row, pascalName) {
        if (!row) return null;
        var camelName = pascalName.charAt(0).toLowerCase() + pascalName.slice(1);
        return row[pascalName] != null ? row[pascalName] : row[camelName];
    }

    function formatSeconds(value) {
        if (value == null || value === '') return '—';
        var number = Number(value);
        if (number < 60) return number.toFixed(1) + 's';
        return (number / 60).toFixed(1) + 'm';
    }

    function metricStatusBadge(status) {
        var normalized = (status || '').toLowerCase();
        var cls = normalized === 'degraded' ? 'badge-failed'
                : normalized === 'watch' ? 'badge-watch'
                : 'badge-ok';
        return '<span class="badge-status ' + cls + '">' + (status || 'Unknown') + '</span>';
    }

    function setDriverMetric(key, status, value, detail) {
        var normalized = (status || '').toLowerCase();
        var panel = $('#metric-' + key);
        panel.removeClass('healthy watch degraded').addClass(normalized || 'healthy');
        $('#metric-' + key + '-status').html(metricStatusBadge(status));
        $('#metric-' + key + '-value').text(value);
        $('#metric-' + key + '-detail').text(detail);
    }

    function refreshMetrics() {
        $.get('@Url.Action("Metrics", "Operations")')
            .done(function (data) {
                var overallStatus = readField(data, 'OverallStatus') || 'Unknown';
                var generatedAt = readField(data, 'GeneratedAtUtc') || '';
                var outboxBacklog = readField(data, 'OutboxBacklog') || 0;
                var outboxRetrying = readField(data, 'OutboxRetrying') || 0;
                var outboxFailed = readField(data, 'OutboxFailed') || 0;
                var publishedLast24Hours = readField(data, 'PublishedLast24Hours') || 0;
                var p95Latency = readField(data, 'P95PublishLatencySecondsLast24Hours');
                var openCircuits = readField(data, 'OpenCircuitBreakers') || 0;
                var halfOpenCircuits = readField(data, 'HalfOpenCircuitBreakers') || 0;
                var circuitFailures = readField(data, 'CircuitBreakerFailures') || 0;
                var staleInventory = readField(data, 'StaleInventoryProjections') || 0;
                var conflictedInventory = readField(data, 'ConflictedInventoryProjections') || 0;
                var pendingReconciliation = readField(data, 'PendingInventoryReconciliations') || 0;
                var newDeadLetters = readField(data, 'NewDeadLetters') || 0;
                var requeuedDeadLetters = readField(data, 'RequeuedDeadLettersLast24Hours') || 0;
                var oldestDeadLetterAge = readField(data, 'OldestNewDeadLetterAgeMinutes');

                $('#metrics-overall').html(metricStatusBadge(overallStatus));
                $('#metrics-updated').text(generatedAt ? 'Updated ' + generatedAt.toString().substring(0, 19).replace('T', ' ') + ' UTC' : '—');

                setDriverMetric(
                    'availability',
                    readField(data, 'AvailabilityStatus'),
                    outboxBacklog + ' queued',
                    'Published 24h: ' + publishedLast24Hours + ' | Failed: ' + outboxFailed + ' | P95 publish: ' + formatSeconds(p95Latency)
                );
                setDriverMetric(
                    'resilience',
                    readField(data, 'ResilienceStatus'),
                    openCircuits + ' open',
                    'Half-open: ' + halfOpenCircuits + ' | Retrying: ' + outboxRetrying + ' | Adapter failures: ' + circuitFailures
                );
                setDriverMetric(
                    'consistency',
                    readField(data, 'ConsistencyStatus'),
                    conflictedInventory + ' conflicts',
                    'Stale: ' + staleInventory + ' | Pending reconciliation: ' + pendingReconciliation
                );
                setDriverMetric(
                    'operability',
                    readField(data, 'OperabilityStatus'),
                    newDeadLetters + ' new DLQ',
                    'Requeued 24h: ' + requeuedDeadLetters + ' | Oldest new: ' + (oldestDeadLetterAge == null ? '—' : Number(oldestDeadLetterAge).toFixed(1) + 'm')
                );
            })
            .fail(function () {
                $('#metrics-overall').html(metricStatusBadge('Degraded'));
                $('.driver-metric').removeClass('healthy watch').addClass('degraded');
                $('.driver-value').text('—');
                $('.driver-secondary').text('Metrics endpoint failed');
            });
    }

    // ── order link (standalone) ───────────────────────────────────────────────
    function renderOrderLink(data) {
        if (!data || data === 0) return '<span class="text-muted">—</span>';
        return '<a href="/Admin/Order/Edit/' + data + '" target="_blank" class="order-link" title="Open order ' + data + ' in admin">#' + data + ' &#x2197;</a>';
    }

    // ── order link + correlation id in one cell ───────────────────────────────
    function renderOrderLinkWithCorr(data, type, row) {
        var corr = row.CorrelationId || row.correlationId || '';
        var link = (data && data !== 0)
            ? '<a href="/Admin/Order/Edit/' + data + '" target="_blank" class="order-link" title="Open order ' + data + '">#' + data + ' &#x2197;</a>'
            : '<span class="text-muted">—</span>';
        var corrSpan = corr ? '<br><span class="corr-id" title="Correlation ID">' + corr + '</span>' : '';
        return link + corrSpan;
    }

    // ── message type badge ────────────────────────────────────────────────────
    function renderMsgType(data) {
        if (!data) return '';
        var lower = data.toLowerCase();
        var cls = lower.indexOf('fulfil') >= 0 ? 'msg-type-fulfillment'
                : lower.indexOf('ship')   >= 0 ? 'msg-type-shipping'
                : lower.indexOf('invent') >= 0 ? 'msg-type-inventory'
                : '';
        var label = data.replace('Requested', '').replace('Updated', ' Upd');
        return '<span class="msg-type-badge ' + cls + '">' + label + '</span>';
    }

    // ── adapter badge ─────────────────────────────────────────────────────────
    function renderAdapterBadge(data) {
        if (!data) return '';
        var lower = (data || '').toLowerCase();
        var cls = lower.indexOf('war') >= 0  ? 'adapter-warehouse'
                : lower.indexOf('ship') >= 0  ? 'adapter-shipping'
                : lower.indexOf('inv') >= 0   ? 'adapter-inventory'
                : lower.indexOf('pos') >= 0   ? 'adapter-storepos'
                : lower.indexOf('sup') >= 0   ? 'adapter-support'
                : '';
        return '<span class="adapter-badge ' + cls + '">' + data + '</span>';
    }

    // ── dead letter correlation → order link if pattern order-N ──────────────
    function renderDlCorrelation(data) {
        if (!data) return '<span class="text-muted">—</span>';
        var m = data.match(/^order-(\d+)/i);
        if (m) {
            return '<a href="/Admin/Order/Edit/' + m[1] + '" target="_blank" class="order-link" title="Open order ' + m[1] + '">'
                 + '<span class="corr-id">' + data + '</span> &#x2197;</a>';
        }
        return '<span class="corr-id">' + data + '</span>';
    }

    // ── truncated error with full text on hover ───────────────────────────────
    function renderError(data) {
        if (!data) return '<span class="text-muted">—</span>';
        var escaped = data.replace(/"/g, '&quot;').replace(/</g, '&lt;');
        var short = data.length > 60 ? data.substring(0, 60) + '…' : data;
        return '<span class="error-tooltip" title="' + escaped + '">' + short + '</span>';
    }

    // ── status badges ─────────────────────────────────────────────────────────
    function statusBadge(val, map) {
        var key = (val || '').toLowerCase();
        var cls = map[key] || '';
        return '<span class="badge-status ' + cls + '">' + (val || '') + '</span>';
    }

    function renderOutboxStatus(data) {
        return statusBadge(data, {
            published: 'badge-published',
            pending:   'badge-pending',
            retrying:  'badge-retrying',
            failed:    'badge-failed'
        });
    }

    function renderDlState(data) {
        return statusBadge(data, {
            new:          'badge-new',
            acknowledged: 'badge-acknowledged',
            requeued:     'badge-requeued'
        });
    }

    // ── requeue buttons ───────────────────────────────────────────────────────
    function renderRequeueOutbox(data, type, row) {
        var s = row.Status || row.status || '';
        if (s === 'Failed' || s === 'Retrying') {
            return '<button onclick="requeueOutbox(' + data + ')" class="requeue-btn requeue-btn-warn" title="Reset to Pending and retry">&#x21ba; Requeue</button>';
        }
        return '';
    }

    function renderRequeueDeadLetter(data, type, row) {
        var s = row.EscalationState || row.escalationState || '';
        if (s === 'New' || s === 'Acknowledged') {
            return '<button onclick="requeueDeadLetter(' + data + ')" class="requeue-btn requeue-btn-danger" title="Create new outbox record from dead letter">&#x21ba; Requeue</button>';
        }
        return '';
    }

    function requeueOutbox(id) {
        if (!confirm('Requeue outbox record #' + id + '?')) return;
        $.post('@Url.Action("RequeueOutbox", "Operations")', { id: id, __RequestVerificationToken: $('input[name=__RequestVerificationToken]').val() })
            .done(function () { $('#outbox-grid').DataTable().ajax.reload(); })
            .fail(function () { alert('Requeue failed.'); });
    }

    function requeueDeadLetter(id) {
        if (!confirm('Requeue dead-letter record #' + id + '? A new outbox record will be created.')) return;
        $.post('@Url.Action("RequeueDeadLetter", "Operations")', { id: id, __RequestVerificationToken: $('input[name=__RequestVerificationToken]').val() })
            .done(function () { $('#deadletter-grid').DataTable().ajax.reload(); $('#outbox-grid').DataTable().ajax.reload(); })
            .fail(function () { alert('Requeue failed.'); });
    }

    // ── circuit breakers ──────────────────────────────────────────────────────
    function refreshCircuitBreakers() {
        $.get('@Url.Action("CircuitBreakerList", "Operations")')
            .done(function (data) {
                var tbody = $('#circuit-breaker-body');
                tbody.empty();
                $('#cb-count').text(data ? data.length : 0);
                if (!data || data.length === 0) {
                    tbody.append('<tr><td colspan="7" class="ops-empty">No circuit breaker state recorded yet.</td></tr>');
                    return;
                }
                $.each(data, function (i, r) {
                    var state    = r.State    || r.state    || '';
                    var adapter  = r.Adapter  || r.adapter  || '';
                    var failures = r.FailureCount != null ? r.FailureCount : (r.failureCount || 0);
                    var lastErr  = r.LastError || r.lastError || '';
                    var opened   = r.OpenedAtUtc   || r.openedAtUtc   || '';
                    var probe    = r.NextProbeAtUtc || r.nextProbeAtUtc || '';
                    var updated  = r.UpdatedAtUtc  || r.updatedAtUtc  || '';

                    var stateCls = state === 'Open'     ? 'badge-open'
                                 : state === 'HalfOpen' ? 'badge-halfopen'
                                 : 'badge-closed';
                    var stateBadge = '<span class="badge-status ' + stateCls + '">' + state + '</span>';

                    var pct  = Math.min(100, Math.round((failures / CB_THRESHOLD) * 100));
                    var barColor = failures === 0 ? '#28a745' : failures >= CB_THRESHOLD ? '#dc3545' : '#ffc107';
                    var bar = '<span style="font-weight:600">' + failures + '</span>'
                            + ' / ' + CB_THRESHOLD
                            + '<span class="failure-bar"><span class="failure-bar-fill" style="width:' + pct + '%;background:' + barColor + '"></span></span>';

                    var errorCell = lastErr
                        ? '<span class="error-tooltip truncate-col" title="' + lastErr.replace(/"/g,'&quot;') + '">' + (lastErr.length > 50 ? lastErr.substring(0,50)+'…' : lastErr) + '</span>'
                        : '<span class="text-muted">—</span>';

                    tbody.append('<tr>'
                        + '<td>' + renderAdapterBadge(adapter) + '</td>'
                        + '<td>' + stateBadge + '</td>'
                        + '<td>' + bar + '</td>'
                        + '<td>' + (opened || '<span class="text-muted">—</span>') + '</td>'
                        + '<td>' + (probe  || '<span class="text-muted">—</span>') + '</td>'
                        + '<td>' + errorCell + '</td>'
                        + '<td>' + updated + '</td>'
                        + '</tr>');
                });
            })
            .fail(function () {
                $('#circuit-breaker-body').html('<tr><td colspan="7" class="text-danger text-center p-3">Failed to load circuit breaker state.</td></tr>');
            });
    }

    // ── inventory projection ──────────────────────────────────────────────────
    function refreshInventoryProjections() {
        $.get('@Url.Action("InventoryProjectionList", "Operations")')
            .done(function (data) {
                var tbody = $('#inventory-projection-body');
                tbody.empty();
                $('#inv-count').text(data ? data.length : 0);
                if (!data || data.length === 0) {
                    tbody.append('<tr><td colspan="9" class="ops-empty">No stale or conflicted inventory records.</td></tr>');
                    return;
                }
                $.each(data, function (i, r) {
                    var pid       = r.ProductId       || r.productId;
                    var src       = r.SourceSystem     || r.sourceSystem     || '';
                    var qty       = r.ReportedQuantity != null ? r.ReportedQuantity : r.reportedQuantity;
                    var confirmed = r.LastConfirmedUtc || r.lastConfirmedUtc  || '';
                    var isStale   = r.IsStale          || r.isStale;
                    var conflict  = r.ConflictFlag     || r.conflictFlag;
                    var pending   = r.PendingReconciliation || r.pendingReconciliation;
                    var resolved  = r.ResolvedAtUtc    || r.resolvedAtUtc;
                    var updated   = r.UpdatedAtUtc     || r.updatedAtUtc     || '';

                    var productLink = '<a href="/Admin/Product/Edit/' + pid + '" target="_blank" class="order-link" title="Edit product ' + pid + '">#' + pid + ' &#x2197;</a>';
                    var srcBadge    = '<span class="adapter-badge ' + (src === 'wms' ? 'adapter-warehouse' : 'adapter-storepos') + '">' + src + '</span>';
                    var staleBadge  = isStale   ? '<span class="badge-status badge-stale">Stale</span>'    : '<span class="badge-status badge-ok">OK</span>';
                    var conflBadge  = conflict  ? '<span class="badge-status badge-conflict">Conflict</span>' : '<span class="badge-status badge-ok">OK</span>';
                    var pendBadge   = pending   ? '<span class="badge-status badge-stale">Yes</span>'      : '<span class="text-muted">—</span>';

                    tbody.append('<tr>'
                        + '<td>' + productLink + '</td>'
                        + '<td>' + srcBadge + '</td>'
                        + '<td><strong>' + qty + '</strong></td>'
                        + '<td>' + confirmed + '</td>'
                        + '<td>' + staleBadge + '</td>'
                        + '<td>' + conflBadge + '</td>'
                        + '<td>' + pendBadge + '</td>'
                        + '<td>' + (resolved || '<span class="text-muted">—</span>') + '</td>'
                        + '<td>' + updated + '</td>'
                        + '</tr>');
                });
            })
            .fail(function () {
                $('#inventory-projection-body').html('<tr><td colspan="9" class="text-danger text-center p-3">Failed to load inventory projections.</td></tr>');
            });
    }

    $(document).ready(function () {
        refreshMetrics();
        refreshCircuitBreakers();
        refreshInventoryProjections();

        // update header counters when DataTables finish loading
        $(document).on('draw.dt', '#outbox-grid', function () {
            var info = $(this).DataTable().page.info();
            $('#outbox-count').text(info.recordsTotal);
        });
        $(document).on('draw.dt', '#deadletter-grid', function () {
            var info = $(this).DataTable().page.info();
            $('#deadletter-count').text(info.recordsTotal);
        });
    });
</script>
