        <mxCell id="support" value="Support / CRM&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;customer service needs reliable order state&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=14;fontStyle=1;fontColor=#334155;" vertex="1" parent="1">
