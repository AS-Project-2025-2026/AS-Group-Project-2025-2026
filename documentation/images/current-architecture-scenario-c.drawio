        <mxCell id="gaps" value="Current integration gaps&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;No durable outbox&lt;br&gt;No broker-level delivery guarantee&lt;br&gt;No standard retry / replay / dead-letter path&lt;br&gt;No freshness or source metadata for external stock/state&lt;br&gt;No common reconciliation status&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF2F2;strokeColor=#DC2626;fontSize=15;fontStyle=1;fontColor=#7F1D1D;align=left;spacing=12;" vertex="1" parent="1">
