        </mxCell>
        <mxCell id="scenario-note" value="Current state: nopCommerce is a modular monolith that owns checkout, order management, catalog, stock and shipment records. Scenario C pressure comes from external operational systems that may be stale, slow, unavailable or contradictory." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=13;fontColor=#334155;align=left;spacing=12;" vertex="1" parent="1">
